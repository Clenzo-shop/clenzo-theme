{%- doc -%}
  "Buy More, Save More" quantity-multiplier card selector. Does not create
  real variants: selecting "Pack of 2" simply sets the real quantity input
  to 2 and shows the discount math (10% off) as an incentive.

  IMPORTANT: this only changes what is displayed and what quantity gets
  added to the cart. It does NOT itself apply a discount at checkout — pair
  it with a Shopify automatic discount ("10% off when quantity is 2+") in
  Settings > Discounts so the price shown here matches what the customer is
  actually charged.

  @param {product} product
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign unit_price = variant.price
  assign pack2_full_price = unit_price | times: 2
  assign pack2_discounted_price = pack2_full_price | times: 90.0 | divided_by: 100.0 | round
  assign pack2_savings = pack2_full_price | minus: pack2_discounted_price
-%}
{%- if variant != blank -%}
  <div class="clenzo-pack-selector" data-clenzo-pack-selector>
    <p class="clenzo-pack-selector__title">Buy More, Save More</p>

    <label class="clenzo-pack-card clenzo-pack-card--selected" data-pack-qty="1">
      <input type="radio" name="clenzo-pack-{{ product.id }}" value="1" checked class="clenzo-pack-card__radio">
      <span class="clenzo-pack-card__radio-dot" aria-hidden="true"></span>
      <span class="clenzo-pack-card__body">
        <span class="clenzo-pack-card__name">Pack of 1</span>
        <span class="clenzo-pack-card__sub">Standard Price</span>
      </span>
      <span class="clenzo-pack-card__price">{{ unit_price | money }}</span>
    </label>

    <label class="clenzo-pack-card" data-pack-qty="2">
      <span class="clenzo-pack-card__ribbon">MOST POPULAR</span>
      <input type="radio" name="clenzo-pack-{{ product.id }}" value="2" class="clenzo-pack-card__radio">
      <span class="clenzo-pack-card__radio-dot" aria-hidden="true"></span>
      <span class="clenzo-pack-card__body">
        <span class="clenzo-pack-card__name">
          Pack of 2
          <span class="clenzo-pack-card__save-pill">Save {{ pack2_savings | money }}</span>
        </span>
        <span class="clenzo-pack-card__sub">You save 10%</span>
      </span>
      <span class="clenzo-pack-card__price">
        {{ pack2_discounted_price | money }}
        <span class="clenzo-pack-card__price-compare">{{ pack2_full_price | money }}</span>
      </span>
    </label>
  </div>

  <script>
    (function () {
      function init() {
        document.querySelectorAll('[data-clenzo-pack-selector]').forEach(function (root) {
          if (root.dataset.clenzoInit) return;
          root.dataset.clenzoInit = 'true';

          var cards = root.querySelectorAll('.clenzo-pack-card');

          cards.forEach(function (card) {
            card.addEventListener('click', function () {
              cards.forEach(function (c) {
                c.classList.remove('clenzo-pack-card--selected');
              });
              card.classList.add('clenzo-pack-card--selected');

              var qty = parseInt(card.dataset.packQty, 10) || 1;
              var details = document.querySelector('.product-details');
              if (!details) return;

              var qtyComponent = details.querySelector('quantity-selector-component');
              if (!qtyComponent) return;

              if (typeof qtyComponent.setValue === 'function') {
                qtyComponent.setValue(String(qty));
              }
              if (typeof qtyComponent.onQuantityChange === 'function') {
                qtyComponent.onQuantityChange();
              }

              var input = qtyComponent.querySelector('input[type="number"]');
              if (input) {
                input.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('shopify:section:load', init);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .clenzo-pack-selector {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .clenzo-pack-selector__title {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-transform: uppercase;
  }

  .clenzo-pack-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .clenzo-pack-card--selected {
    border-color: #143e91;
    background: rgb(20 62 145 / 0.05);
  }

  .clenzo-pack-card__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .clenzo-pack-card__radio-dot {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.3);
    position: relative;
  }

  .clenzo-pack-card--selected .clenzo-pack-card__radio-dot {
    border-color: #143e91;
  }

  .clenzo-pack-card--selected .clenzo-pack-card__radio-dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: #143e91;
  }

  .clenzo-pack-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .clenzo-pack-card__name {
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .clenzo-pack-card__sub {
    font-size: 0.8rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .clenzo-pack-card__save-pill {
    font-size: 0.7rem;
    font-weight: 700;
    color: #1f8a4c;
    background: rgb(31 138 76 / 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .clenzo-pack-card__price {
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .clenzo-pack-card__price-compare {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    text-decoration: line-through;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  .clenzo-pack-card__ribbon {
    position: absolute;
    top: -10px;
    right: 12px;
    background: #143e91;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
{% endstylesheet %}
