{%- doc -%}
  Renders the "VENDOR · CATEGORY" eyebrow line above the product title.
  Category text comes from product.metafields.custom.eyebrow_category,
  falling back to the product's type.

  @param {product} product
{%- enddoc -%}

{%- liquid
  assign eyebrow_category = product.metafields.custom.eyebrow_category.value | default: product.type
-%}
{%- if product.vendor != blank or eyebrow_category != blank -%}
  <p class="clenzo-eyebrow">
    {%- if product.vendor != blank -%}{{ product.vendor | upcase }}{%- endif -%}
    {%- if product.vendor != blank and eyebrow_category != blank -%}
      <span class="clenzo-eyebrow__dot">·</span>
    {%- endif -%}
    {%- if eyebrow_category != blank -%}{{ eyebrow_category | upcase }}{%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .clenzo-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1f8a4c;
  }

  .clenzo-eyebrow__dot {
    margin: 0 0.35em;
  }
{% endstylesheet %}
