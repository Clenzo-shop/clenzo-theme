{%- doc -%}
  "You Will Love This" cross-sell add-on checkboxes. Products come from
  product.metafields.custom.addon_products (a list.product_reference
  metafield, up to 2 shown), so each product picks its own add-ons manually.

  Checked add-ons are added to the cart alongside the main product a moment
  after the native Add to Cart button is clicked. This is a best-effort,
  decoupled fetch — verify in the live theme preview that the cart
  drawer/notification reflects both line items as expected.

  Known limitation: the native "Buy It Now" (Shopify dynamic checkout)
  button starts checkout on its own and will NOT include checked add-ons.
  Use the custom "clenzo-buy-now-button" snippet instead, which does
  include them.

  @param {product} product
{%- enddoc -%}

{%- liquid
  assign addon_products = product.metafields.custom.addon_products.value
-%}
{%- if addon_products != blank and addon_products.size > 0 -%}
  <div class="clenzo-addon-upsell" data-clenzo-addon-upsell>
    <div class="clenzo-addon-upsell__header">
      <p class="clenzo-addon-upsell__title">You Will Love This</p>
      <span class="clenzo-addon-upsell__hint">Add to your order</span>
    </div>
    <div class="clenzo-addon-upsell__list">
      {%- for addon in addon_products limit: 2 -%}
        {%- liquid
          assign addon_variant = addon.selected_or_first_available_variant
          assign addon_image = addon.featured_image
        -%}
        <label class="clenzo-addon-item">
          <input type="checkbox" class="clenzo-addon-item__checkbox" data-variant-id="{{ addon_variant.id }}">
          <span class="clenzo-addon-item__checkbox-box" aria-hidden="true">
            <span class="clenzo-addon-item__check-icon">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
          </span>
          {%- if addon_image != blank -%}
            <span class="clenzo-addon-item__image">
              {{
                addon_image
                | image_url: width: 120
                | image_tag: loading: 'lazy', alt: addon.title | escape, widths: '80,120', sizes: '44px'
              }}
            </span>
          {%- endif -%}
          <span class="clenzo-addon-item__info">
            <span class="clenzo-addon-item__name">{{ addon.title }}</span>
            {%- if addon_variant.compare_at_price > addon_variant.price -%}
              <span class="clenzo-addon-item__save">
                Save {{ addon_variant.compare_at_price | minus: addon_variant.price | money }}
              </span>
            {%- endif -%}
          </span>
          <span class="clenzo-addon-item__price">
            {{ addon_variant.price | money }}
            {%- if addon_variant.compare_at_price > addon_variant.price -%}
              <span class="clenzo-addon-item__price-compare">{{ addon_variant.compare_at_price | money }}</span>
            {%- endif -%}
          </span>
        </label>
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      function collectSelectedAddonItems(root) {
        var items = [];
        root.querySelectorAll('.clenzo-addon-item__checkbox:checked').forEach(function (cb) {
          var variantId = parseInt(cb.dataset.variantId, 10);
          if (variantId) items.push({ id: variantId, quantity: 1 });
        });
        return items;
      }

      function addAddonsToCart(items) {
        if (!items.length) return;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).catch(function () {});
      }

      function init() {
        var root = document.querySelector('[data-clenzo-addon-upsell]');
        if (!root || root.dataset.clenzoInit) return;
        root.dataset.clenzoInit = 'true';

        var details = document.querySelector('.product-details');
        if (!details) return;

        var form = details.querySelector('form[data-type="add-to-cart-form"]');
        if (!form) return;

        form.addEventListener(
          'submit',
          function () {
            var items = collectSelectedAddonItems(root);
            if (!items.length) return;
            setTimeout(function () {
              addAddonsToCart(items);
            }, 900);
          },
          true
        );
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('shopify:section:load', init);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .clenzo-addon-upsell {
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 12px;
    padding: 1rem;
    background: rgb(var(--color-foreground-rgb) / 0.02);
  }

  .clenzo-addon-upsell__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
  }

  .clenzo-addon-upsell__title {
    margin: 0;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .clenzo-addon-upsell__hint {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    white-space: nowrap;
  }

  .clenzo-addon-upsell__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .clenzo-addon-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
    cursor: pointer;
  }

  .clenzo-addon-item__checkbox {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .clenzo-addon-item__checkbox-box {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .clenzo-addon-item__check-icon {
    width: 12px;
    height: 12px;
    opacity: 0;
  }

  .clenzo-addon-item__check-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .clenzo-addon-item__checkbox:checked + .clenzo-addon-item__checkbox-box {
    background: #143e91;
    border-color: #143e91;
  }

  .clenzo-addon-item__checkbox:checked + .clenzo-addon-item__checkbox-box .clenzo-addon-item__check-icon {
    opacity: 1;
    color: #fff;
  }

  .clenzo-addon-item__image {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
  }

  .clenzo-addon-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .clenzo-addon-item__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .clenzo-addon-item__name {
    font-weight: 600;
    font-size: 0.9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .clenzo-addon-item__save {
    font-size: 0.75rem;
    color: #1f8a4c;
  }

  .clenzo-addon-item__price {
    text-align: right;
    font-weight: 700;
    white-space: nowrap;
  }

  .clenzo-addon-item__price-compare {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    text-decoration: line-through;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }
{% endstylesheet %}
