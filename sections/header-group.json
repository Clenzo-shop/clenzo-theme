{"type":"header","name":"t:names.header","sections":{"custom_liquid_ERJpeD":{"type":"custom-liquid","name":"Top Bar","settings":{"custom_liquid":"<!-- =========================================================\n     CLENZO — TOP ANNOUNCEMENT BAR\n     Shopify Custom Liquid\n========================================================= -->\n\n<style>\n  \/* =========================================================\n     MAIN ANNOUNCEMENT BAR\n  ========================================================= *\/\n\n  .clenzo-announcement-bar {\n    width: 100%;\n    height: 38px;\n    background: #0b5ed7;\n    color: #ffffff;\n    font-family: Arial, Helvetica, sans-serif;\n    position: relative;\n    z-index: 100;\n    overflow: hidden;\n  }\n\n  .clenzo-announcement-inner {\n    width: 100%;\n    max-width: 1500px;\n    height: 100%;\n    margin: 0 auto;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  \/* =========================================================\n     LEFT \/ MAIN ANNOUNCEMENT AREA\n  ========================================================= *\/\n\n  .clenzo-announcement-main {\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .clenzo-announcement-items {\n    display: flex;\n    align-items: center;\n    height: 100%;\n  }\n\n  \/* =========================================================\n     INDIVIDUAL ANNOUNCEMENT ITEM\n  ========================================================= *\/\n\n  .clenzo-announcement-item {\n    height: 100%;\n    padding: 0 24px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n\n    white-space: nowrap;\n\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: 0.2px;\n  }\n\n  .clenzo-announcement-item + .clenzo-announcement-item {\n    border-left: 1px solid rgba(255,255,255,0.30);\n  }\n\n  .clenzo-announcement-icon {\n    width: 16px;\n    height: 16px;\n\n    flex: 0 0 16px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .clenzo-announcement-icon svg {\n    width: 16px;\n    height: 16px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  \/* =========================================================\n     SOCIAL AREA — DESKTOP ONLY\n  ========================================================= *\/\n\n  .clenzo-announcement-social {\n    height: 100%;\n\n    margin-left: 18px;\n    padding-left: 20px;\n\n    display: flex;\n    align-items: center;\n    gap: 10px;\n\n    border-left: 1px solid rgba(255,255,255,0.30);\n  }\n\n  .clenzo-follow-text {\n    font-size: 11px;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n\n  .clenzo-social-link {\n    width: 22px;\n    height: 22px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    color: #ffffff;\n\n    text-decoration: none;\n\n    border: 1px solid rgba(255,255,255,0.75);\n    border-radius: 50%;\n\n    transition:\n      background 0.2s ease,\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .clenzo-social-link:hover {\n    background: #ffffff;\n    color: #0b5ed7;\n    transform: translateY(-1px);\n  }\n\n  .clenzo-social-link svg {\n    width: 12px;\n    height: 12px;\n    fill: currentColor;\n  }\n\n  \/* =========================================================\n     MOBILE SLIDER\n  ========================================================= *\/\n\n  .clenzo-mobile-slider {\n    display: none;\n  }\n\n  .clenzo-mobile-slide {\n    position: absolute;\n\n    left: 0;\n    right: 0;\n    top: 0;\n\n    height: 38px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 0 38px;\n\n    opacity: 0;\n    transform: translateX(15px);\n\n    transition:\n      opacity 0.45s ease,\n      transform 0.45s ease;\n\n    pointer-events: none;\n  }\n\n  .clenzo-mobile-slide.active {\n    opacity: 1;\n    transform: translateX(0);\n    pointer-events: auto;\n  }\n\n  .clenzo-mobile-slide-content {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 8px;\n\n    width: 100%;\n\n    color: #ffffff;\n\n    font-size: 13px;\n    font-weight: 700;\n\n    line-height: 1;\n\n    text-align: center;\n\n    white-space: nowrap;\n  }\n\n  .clenzo-mobile-slide-content .clenzo-announcement-icon {\n    flex-shrink: 0;\n  }\n\n  \/* =========================================================\n     MOBILE — 767px AND BELOW\n  ========================================================= *\/\n\n  @media screen and (max-width: 767px) {\n\n    .clenzo-announcement-bar {\n      height: 36px;\n    }\n\n    \/* Hide desktop announcements *\/\n    .clenzo-announcement-main {\n      display: none;\n    }\n\n    \/* Hide social links *\/\n    .clenzo-announcement-social {\n      display: none;\n    }\n\n    \/* Show mobile slider *\/\n    .clenzo-mobile-slider {\n      display: block;\n\n      position: relative;\n\n      width: 100%;\n      height: 36px;\n    }\n\n    .clenzo-mobile-slide {\n      height: 36px;\n    }\n\n    \/* UPDATED MOBILE FONT SIZE *\/\n    .clenzo-mobile-slide-content {\n      font-size: 12.5px;\n\n      gap: 7px;\n\n      padding: 0 8px;\n    }\n\n    .clenzo-mobile-slide-content\n    .clenzo-announcement-icon {\n      width: 15px;\n      height: 15px;\n      flex-basis: 15px;\n    }\n\n    .clenzo-mobile-slide-content\n    .clenzo-announcement-icon svg {\n      width: 15px;\n      height: 15px;\n    }\n  }\n\n  \/* =========================================================\n     EXTRA SMALL MOBILE\n  ========================================================= *\/\n\n  @media screen and (max-width: 380px) {\n\n    .clenzo-mobile-slide-content {\n      font-size: 12px;\n    }\n\n  }\n\n<\/style>\n\n\n<!-- =========================================================\n     HTML\n========================================================= -->\n\n<div\n  class=\"clenzo-announcement-bar\"\n  id=\"clenzo-announcement-bar\"\n>\n\n  <div class=\"clenzo-announcement-inner\">\n\n    <!-- =====================================================\n         DESKTOP CONTENT\n    ====================================================== -->\n\n    <div class=\"clenzo-announcement-main\">\n\n      <div class=\"clenzo-announcement-items\">\n\n        <!-- ITEM 1 — DELIVERY -->\n\n        <div class=\"clenzo-announcement-item\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M3 6h11v11H3z\"\/>\n              <path d=\"M14 10h4l3 3v4h-7z\"\/>\n              <circle cx=\"7\" cy=\"19\" r=\"2\"\/>\n              <circle cx=\"18\" cy=\"19\" r=\"2\"\/>\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Free Delivery on Bundles\n          <\/span>\n\n        <\/div>\n\n\n        <!-- ITEM 2 — COD -->\n\n        <div class=\"clenzo-announcement-item\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n\n              <rect\n                x=\"3\"\n                y=\"6\"\n                width=\"18\"\n                height=\"13\"\n                rx=\"2\"\n              \/>\n\n              <path d=\"M3 10h18\"\/>\n              <path d=\"M8 15h3\"\/>\n              <path d=\"M16 14v3\"\/>\n              <path d=\"M14.5 15.5h3\"\/>\n\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Cash on Delivery Available\n          <\/span>\n\n        <\/div>\n\n\n        <!-- ITEM 3 — PAKISTAN -->\n\n        <div class=\"clenzo-announcement-item\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n\n              <path d=\"M5 4h14v16H5z\"\/>\n\n              <path d=\"M8 7l4 3 4-3\"\/>\n\n              <path d=\"M8 17h8\"\/>\n\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Proudly Made in Pakistan\n          <\/span>\n\n        <\/div>\n\n      <\/div>\n\n\n      <!-- ===================================================\n           SOCIAL ICONS\n      ==================================================== -->\n\n      <div class=\"clenzo-announcement-social\">\n\n        <span class=\"clenzo-follow-text\">\n          Follow Us:\n        <\/span>\n\n\n        <!-- Facebook -->\n\n        <a\n          href=\"https:\/\/www.facebook.com\/clenzo.pk\"\n          class=\"clenzo-social-link\"\n          aria-label=\"Facebook\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path\n              d=\"M14 8h3V4h-3\n              c-3.3 0-5 1.7-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9\n              c0-0.7.3-1 1-1z\"\n            \/>\n\n          <\/svg>\n\n        <\/a>\n\n\n        <!-- Instagram -->\n\n        <a\n          href=\"https:\/\/www.instagram.com\/clenzo.pk\/\"\n          class=\"clenzo-social-link\"\n          aria-label=\"Instagram\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <rect\n              x=\"3\"\n              y=\"3\"\n              width=\"18\"\n              height=\"18\"\n              rx=\"5\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n            \/>\n\n            <circle\n              cx=\"12\"\n              cy=\"12\"\n              r=\"4\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n            \/>\n\n            <circle\n              cx=\"17.5\"\n              cy=\"6.5\"\n              r=\"1\"\n            \/>\n\n          <\/svg>\n\n        <\/a>\n\n\n        <!-- TikTok -->\n\n        <a\n          href=\"https:\/\/www.tiktok.com\/@clenzopk\"\n          class=\"clenzo-social-link\"\n          aria-label=\"TikTok\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path\n              d=\"M15 4\n              v10\n              a4 4 0 1 1-4-4\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n            \/>\n\n            <path\n              d=\"M15 4\n              c1 2 2.5 3 5 3\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n            \/>\n\n          <\/svg>\n\n        <\/a>\n\n\n        <!-- YouTube -->\n\n        <a\n          href=\"https:\/\/www.youtube.com\/@Clenzopk\"\n          class=\"clenzo-social-link\"\n          aria-label=\"YouTube\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path\n              d=\"M21 8\n              c-.2-1.1-1.1-2-2.2-2.2\n              C17 5.5 12 5.5 12 5.5\n              s-5 0-6.8.3\n              C4.1 6 3.2 6.9 3 8\n              c-.3 1.7-.3 4-.3 4\n              s0 2.3.3 4\n              c.2 1.1 1.1 2 2.2 2.2\n              C7 18.5 12 18.5 12 18.5\n              s5 0 6.8-.3\n              c1.1-.2 2-1.1 2.2-2.2\n              .3-1.7.3-4 .3-4\n              s0-2.3-.3-4z\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.5\"\n            \/>\n\n            <path\n              d=\"M10 9\n              l5 3-5 3z\"\n            \/>\n\n          <\/svg>\n\n        <\/a>\n\n      <\/div>\n\n    <\/div>\n\n\n    <!-- =====================================================\n         MOBILE SLIDER\n    ====================================================== -->\n\n    <div\n      class=\"clenzo-mobile-slider\"\n      aria-label=\"Store announcements\"\n    >\n\n\n      <!-- MOBILE SLIDE 1 -->\n\n      <div\n        class=\"clenzo-mobile-slide active\"\n      >\n\n        <div class=\"clenzo-mobile-slide-content\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n\n              <path d=\"M3 6h11v11H3z\"\/>\n              <path d=\"M14 10h4l3 3v4h-7z\"\/>\n              <circle cx=\"7\" cy=\"19\" r=\"2\"\/>\n              <circle cx=\"18\" cy=\"19\" r=\"2\"\/>\n\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Free Delivery on Bundles\n          <\/span>\n\n        <\/div>\n\n      <\/div>\n\n\n      <!-- MOBILE SLIDE 2 -->\n\n      <div\n        class=\"clenzo-mobile-slide\"\n      >\n\n        <div class=\"clenzo-mobile-slide-content\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n\n              <rect\n                x=\"3\"\n                y=\"6\"\n                width=\"18\"\n                height=\"13\"\n                rx=\"2\"\n              \/>\n\n              <path d=\"M3 10h18\"\/>\n              <path d=\"M8 15h3\"\/>\n              <path d=\"M16 14v3\"\/>\n              <path d=\"M14.5 15.5h3\"\/>\n\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Cash on Delivery Available\n          <\/span>\n\n        <\/div>\n\n      <\/div>\n\n\n      <!-- MOBILE SLIDE 3 -->\n\n      <div\n        class=\"clenzo-mobile-slide\"\n      >\n\n        <div class=\"clenzo-mobile-slide-content\">\n\n          <span class=\"clenzo-announcement-icon\">\n\n            <svg viewBox=\"0 0 24 24\">\n\n              <path d=\"M5 4h14v16H5z\"\/>\n              <path d=\"M8 7l4 3 4-3\"\/>\n              <path d=\"M8 17h8\"\/>\n\n            <\/svg>\n\n          <\/span>\n\n          <span>\n            Proudly Made in Pakistan\n          <\/span>\n\n        <\/div>\n\n      <\/div>\n\n\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n\n<!-- =========================================================\n     VANILLA JAVASCRIPT\n     Mobile slider only\n========================================================= -->\n\n<script>\n(function () {\n\n  'use strict';\n\n  var clenZoBar = document.getElementById(\n    'clenzo-announcement-bar'\n  );\n\n  if (!clenZoBar) return;\n\n\n  var clenZoSlides =\n    clenZoBar.querySelectorAll(\n      '.clenzo-mobile-slide'\n    );\n\n\n  var clenZoCurrentSlide = 0;\n\n  var clenZoSlideInterval = null;\n\n\n  \/* =======================================================\n     SHOW SLIDE\n  ======================================================== *\/\n\n  function clenZoShowSlide(index) {\n\n    clenZoSlides.forEach(function (slide, i) {\n\n      slide.classList.toggle(\n        'active',\n        i === index\n      );\n\n    });\n\n  }\n\n\n  \/* =======================================================\n     NEXT SLIDE\n  ======================================================== *\/\n\n  function clenZoNextSlide() {\n\n    clenZoCurrentSlide =\n      (clenZoCurrentSlide + 1)\n      % clenZoSlides.length;\n\n    clenZoShowSlide(\n      clenZoCurrentSlide\n    );\n\n  }\n\n\n  \/* =======================================================\n     START SLIDER\n     3500ms = 3.5 seconds\n  ======================================================== *\/\n\n  function clenZoStartSlider() {\n\n    if (\n      window.innerWidth <= 767 &&\n      clenZoSlides.length > 1\n    ) {\n\n      if (!clenZoSlideInterval) {\n\n        clenZoSlideInterval =\n          setInterval(\n            clenZoNextSlide,\n            3500\n          );\n\n      }\n\n    }\n\n  }\n\n\n  \/* =======================================================\n     STOP SLIDER ON DESKTOP\n  ======================================================== *\/\n\n  function clenZoStopSlider() {\n\n    if (clenZoSlideInterval) {\n\n      clearInterval(\n        clenZoSlideInterval\n      );\n\n      clenZoSlideInterval = null;\n\n    }\n\n  }\n\n\n  \/* =======================================================\n     RESPONSIVE CHECK\n  ======================================================== *\/\n\n  function clenZoResponsiveSlider() {\n\n    if (window.innerWidth <= 767) {\n\n      clenZoStartSlider();\n\n    } else {\n\n      clenZoStopSlider();\n\n    }\n\n  }\n\n\n  \/* Initial setup *\/\n\n  clenZoResponsiveSlider();\n\n\n  \/* Handle screen resize *\/\n\n  window.addEventListener(\n    'resize',\n    clenZoResponsiveSlider\n  );\n\n\n})();\n<\/script>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"header_announcements_9jGBFp":{"type":"header-announcements","blocks":{"announcement_BxgCk9":{"type":"_announcement","settings":{"text":"Welcome to our store","link":"","font":"var(--font-subheading--family)","font_size":"0.75rem","weight":"","letter_spacing":"normal","case":"none","text_color":""},"blocks":{}}},"block_order":["announcement_BxgCk9"],"disabled":true,"name":"t:names.announcement_bar","settings":{"speed":5,"section_width":"page-width","background_color":"{{ settings.color_palette.background }}","divider_width":1,"divider_color":"{{ settings.color_palette.color2 }}","padding-block-start":15,"padding-block-end":15}},"header_section":{"type":"header","blocks":{"header-logo":{"type":"_header-logo","static":true,"settings":{"hide_logo_on_home_page":false,"padding-block-start":0,"padding-block-end":0},"blocks":{}},"header-menu":{"type":"_header-menu","static":true,"settings":{"menu":"main-menu","background_color":"{{ settings.color_palette.background }}","text_color":"","type_font_primary_size":"1rem","menu_font_style":"inverse","type_font_primary_link":"heading","type_case_primary_link":"uppercase","menu_style":"text","featured_products_aspect_ratio":"4 \/ 5","featured_collections_aspect_ratio":"16 \/ 9","image_border_radius":0,"navigation_bar":false,"background_color_navigation_bar":"{{ settings.color_palette.background }}","text_color_navigation_bar":"","drawer_accordion":false,"drawer_accordion_expand_first":false,"drawer_dividers":false},"blocks":{}}},"settings":{"logo_position":"left","menu_position":"center","menu_row":"top","customer_account_menu":"customer-account-main-menu","show_search":true,"search_position":"right","search_row":"top","show_country":true,"country_selector_style":false,"show_language":true,"localization_font":"